diff --git a/pcre1compat.h b/pcre1compat.h
new file mode 100644
index 0000000..5219df9
--- /dev/null
+++ b/pcre1compat.h
@@ -0,0 +1,106 @@
+/*
+ * pcre1compat.h - the sliver of PCRE1 that vanitygen uses, on top of PCRE2.
+ *
+ * Ubuntu 24.04 and friends no longer ship PCRE1 (libpcre3), which reached end
+ * of life in 2021.  vanitygen calls exactly five PCRE1 entry points, so rather
+ * than vendoring a dead library we map them onto PCRE2 here and leave
+ * pattern.c otherwise untouched.
+ *
+ * Two deliberate differences from PCRE1, neither of which vanitygen can see:
+ *
+ *  - pcre_study() is a no-op that requests a JIT compile instead.  PCRE2 keeps
+ *    JIT state inside the compiled pattern, so there is no separate "extra"
+ *    object; the shim returns NULL and pcre_free(NULL) is a no-op.  The
+ *    vcr_regex_extra[] slots stay NULL for the life of the process.
+ *
+ *  - pcre_exec()'s caller-supplied ovector is ignored in favour of a
+ *    thread-local pcre2_match_data.  vg_regex_test() never reads the ovector -
+ *    it only asks "did this match" - and PCRE2 requires match data to be
+ *    private to the matching thread, which a shared study block was not.
+ *    Sized at 32 capture pairs, against PCRE1's 3 here, so patterns that would
+ *    have overflowed the original ovector now work.
+ *
+ * This file is part of the vanitygen patch set and is licensed AGPL-3.0, the
+ * same as the program it patches.
+ */
+
+#ifndef __VG_PCRE1COMPAT_H__
+#define __VG_PCRE1COMPAT_H__
+
+#define PCRE2_CODE_UNIT_WIDTH 8
+#include <pcre2.h>
+#include <stdint.h>
+
+typedef pcre2_code pcre;
+typedef void pcre_extra;
+
+#define PCRE_ERROR_NOMATCH PCRE2_ERROR_NOMATCH
+
+static __thread char vg_pcre2_errbuf[256];
+static __thread pcre2_match_data *vg_pcre2_md;
+
+static inline pcre *
+vg_pcre_compile(const char *pattern, int options, const char **errptr,
+		int *erroffset, const unsigned char *tables)
+{
+	pcre2_code *re;
+	PCRE2_SIZE erroff = 0;
+	int errcode = 0;
+
+	(void) tables;
+	re = pcre2_compile((PCRE2_SPTR) pattern, PCRE2_ZERO_TERMINATED,
+			   (uint32_t) options, &errcode, &erroff, NULL);
+	if (!re) {
+		pcre2_get_error_message(errcode, (PCRE2_UCHAR *) vg_pcre2_errbuf,
+					sizeof(vg_pcre2_errbuf));
+		*errptr = vg_pcre2_errbuf;
+		*erroffset = (int) erroff;
+		return NULL;
+	}
+	*errptr = NULL;
+	*erroffset = 0;
+	return re;
+}
+
+static inline pcre_extra *
+vg_pcre_study(pcre *code, int options, const char **errptr)
+{
+	(void) options;
+	/* Best effort: PCRE2 falls back to the interpreter if JIT is absent. */
+	pcre2_jit_compile(code, PCRE2_JIT_COMPLETE);
+	*errptr = NULL;
+	return NULL;
+}
+
+static inline int
+vg_pcre_exec(const pcre *code, pcre_extra *extra, const char *subject,
+	     int length, int startoffset, int options,
+	     int *ovector, int ovecsize)
+{
+	(void) extra;
+	(void) ovector;
+	(void) ovecsize;
+
+	if (!vg_pcre2_md) {
+		vg_pcre2_md = pcre2_match_data_create(32, NULL);
+		if (!vg_pcre2_md)
+			return PCRE2_ERROR_NOMEMORY;
+	}
+	return pcre2_match(code, (PCRE2_SPTR) subject, (PCRE2_SIZE) length,
+			   (PCRE2_SIZE) startoffset, (uint32_t) options,
+			   vg_pcre2_md, NULL);
+}
+
+static inline void
+vg_pcre_free(void *ptr)
+{
+	if (ptr)
+		pcre2_code_free((pcre2_code *) ptr);
+}
+
+#define pcre_compile	vg_pcre_compile
+#define pcre_study	vg_pcre_study
+#define pcre_exec	vg_pcre_exec
+#define pcre_free	vg_pcre_free
+
+#endif /* __VG_PCRE1COMPAT_H__ */
