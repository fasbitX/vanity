diff --git a/Makefile b/Makefile
index 3486201..f1f444b 100644
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,5 @@
-LIBS=-lpcre -lcrypto -lm -lpthread
-CFLAGS=-ggdb -O3 -Wall
